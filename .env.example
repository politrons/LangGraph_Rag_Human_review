# Local development only. Replace this value before using any non-local environment.
AUDIT_HMAC_KEY=change-this-local-audit-key-to-a-random-value

# Ollama local defaults
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_DECISION_MODEL=llama3.1:8b
OLLAMA_SCORING_MODEL=llama3.1:8b
OLLAMA_EMBEDDING_MODEL=nomic-embed-text
